# Backend Environment Configuration for AWS Deployment
# Copy file này thành .env trên AWS EC2 instance

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=db
DB_NAME=galaxy_cinema
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
JWT_SECRET=change_this_to_random_string_in_production_min_32_chars
JWT_EXPIRATION=86400

# ============================================================================
# AWS PUBLIC URLs (⚠️ QUAN TRỌNG CHO WEBHOOK!)
# ============================================================================
# Option 1: Custom domain (Recommended)
APP_URL=https://api.galaxy-cinema.com
FRONTEND_URL=https://galaxy-cinema.com

# Option 2: EC2 Public DNS
# APP_URL=http://ec2-54-123-45-67.ap-southeast-1.compute.amazonaws.com
# FRONTEND_URL=http://ec2-54-123-45-67.ap-southeast-1.compute.amazonaws.com

# Option 3: Load Balancer
# APP_URL=http://cinema-alb-123456789.ap-southeast-1.elb.amazonaws.com
# FRONTEND_URL=http://cinema-alb-123456789.ap-southeast-1.elb.amazonaws.com

# ============================================================================
# MOMO PAYMENT GATEWAY (Production)
# ============================================================================
MOMO_PARTNER_CODE=MOMOXXX
MOMO_ACCESS_KEY=your_access_key_from_momo
MOMO_SECRET_KEY=your_secret_key_from_momo

# MoMo Webhook URLs (Sử dụng APP_URL bên trên)
MOMO_NOTIFY_URL=https://api.galaxy-cinema.com/api/transactions/momo/verify
MOMO_RETURN_URL=https://galaxy-cinema.com/booking/success

# MoMo POS (nếu dùng QR code tại quầy)
MOMO_POS_RETURN_URL=https://momo.vn/

# ============================================================================
# VNPAY PAYMENT GATEWAY (Production)
# ============================================================================
VNP_TMNCODE=your_terminal_code_from_vnpay
VNP_HASH_SECRET=your_hash_secret_from_vnpay
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# VNPay Webhook URLs
VNPAY_NOTIFY_URL=https://api.galaxy-cinema.com/api/transactions/vnpay/ipn

# ============================================================================
# PUSHER REAL-TIME NOTIFICATIONS
# ============================================================================
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap1

# ============================================================================
# SMTP EMAIL CONFIGURATION (Production)
# ============================================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@galaxy-cinema.com
SMTP_FROM_NAME=Galaxy Cinema

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Galaxy Cinema
APP_VERSION=1.0.0
TIMEZONE=Asia/Ho_Chi_Minh
APP_ENV=production

# Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# ============================================================================
# SECURITY SETTINGS (Production)
# ============================================================================
# Enable HTTPS redirect (nếu có SSL)
FORCE_HTTPS=true

# CORS Settings
CORS_ALLOWED_ORIGINS=https://galaxy-cinema.com,https://www.galaxy-cinema.com

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=info
LOG_PATH=/var/log/galaxy-cinema/

# ============================================================================
# NOTES FOR AWS DEPLOYMENT
# ============================================================================
# 1. Thay thế APP_URL và FRONTEND_URL bằng domain/IP thực tế của bạn
# 2. Cập nhật MoMo credentials từ MoMo Business Portal
# 3. Cập nhật VNPay credentials từ VNPay Portal
# 4. Setup SSL certificate bằng Let's Encrypt (certbot)
# 5. Cấu hình MOMO_NOTIFY_URL trong MoMo Portal
# 6. Test webhook sau khi deploy: curl -I <MOMO_NOTIFY_URL>
# 7. KHÔNG commit file này lên Git!
# ============================================================================
