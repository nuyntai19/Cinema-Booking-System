RewriteEngine On
RewriteBase /backend/api/users/

# Handle /users/{id}/profile
RewriteRule ^([0-9]+)/profile$ profile.php?id=$1 [L,QSA]

# Handle /users/{id}/change-password  
RewriteRule ^([0-9]+)/change-password$ change-password.php?id=$1 [L,QSA]

# Handle /users/{id} (get/update/delete user)
RewriteRule ^([0-9]+)$ user.php?id=$1 [L,QSA]
